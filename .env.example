# Na Pista — copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=4200

# UL Platform's public v1 API — the ONLY way this app ever reaches the
# Platform. Never a database connection string to the Platform's own DB.
PLATFORM_API_URL=http://127.0.0.1:4000/v1

# Na Pista's OWN Postgres connection — never UL Platform's (CLAUDE.md §2).
# See docs/decisions.md (F19) OD-16 for why, in this environment only,
# that means a dedicated schema on the same physical server rather than a
# fully separate instance.
NA_PISTA_DATABASE_URL=
NA_PISTA_DB_SCHEMA=na_pista

# F29A: key for each organization's Platform credential at rest (AES-256-GCM).
# Base64 of exactly 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Na Pista-only — never UL Platform's WEBHOOK_SECRET_ENCRYPTION_KEY or any
# other service's key. REQUIRED in production (startup fails without it);
# optional in development/test, where credential use then fails closed.
# Changing it makes every stored credential undecryptable (re-provision).
NA_PISTA_CREDENTIAL_ENCRYPTION_KEY=

# D2-B: the UL Platform PROVISIONER credential (PLATFORM_SERVICE, purpose
# PROVISIONER, scope credential.provision — created by a PLATFORM_ADMIN). When
# set, the server's reconciler pulls each organization's managed Platform
# credential server-to-server and stores it with F29A. A deployment secret:
# never commit it, never put it in a working file. Empty = no reconciler.
NA_PISTA_PROVISIONING_CREDENTIAL=
NA_PISTA_RECONCILE_INTERVAL_MS=30000

# Fase 6 / D2-B: in production the UL application-access check is ALWAYS
# enforced; "true" also enforces it in development/test.
NA_PISTA_REQUIRE_UL_APPLICATION_ACCESS=false

# Browser origins allowed to call this API with credentials (the Default
# UI's dev server). Comma-separated. No default in staging/production.
NA_PISTA_ALLOWED_ORIGINS=http://localhost:3010

# Na Pista — copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=4200

# UL Platform's public v1 API — the ONLY way this app ever reaches the
# Platform. Never a database connection string to the Platform's own DB.
PLATFORM_API_URL=http://127.0.0.1:4000/v1

# Na Pista's OWN Postgres connection — never UL Platform's (CLAUDE.md §2).
# See docs/decisions.md (F19) OD-16 for why, in this environment only,
# that means a dedicated schema on the same physical server rather than a
# fully separate instance.
NA_PISTA_DATABASE_URL=
NA_PISTA_DB_SCHEMA=na_pista

# Browser origins allowed to call this API with credentials (the Default
# UI's dev server). Comma-separated. No default in staging/production.
NA_PISTA_ALLOWED_ORIGINS=http://localhost:3010

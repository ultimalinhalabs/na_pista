# F19 spike config. Copy to .env and fill in — never commit real values.

# This spike's own HTTP port (separate process from UL Platform).
PORT=4100

# UL Platform's public v1 API — the ONLY way this spike ever reaches the
# Platform. Never a database connection string to the Platform's own DB.
PLATFORM_API_URL=http://127.0.0.1:4000/v1

# UL Platform's Supabase project — used ONLY to fetch the public JWKS
# (no secret). See docs/decisions.md ADR-012 for why this spike does not
# verify JWT signatures locally at all in the default path.
SUPABASE_URL=

# This spike's OWN Postgres connection (Na Pista's own database — never
# UL Platform's). In this environment there was no separate Postgres
# instance available, so the spike uses a dedicated schema
# (NA_PISTA_DB_SCHEMA) on the same physical server as a documented,
# reversible compromise — see docs/decisions.md OD-16 / ADR-015.
NA_PISTA_DATABASE_URL=
NA_PISTA_DB_SCHEMA=na_pista_spike

# Na Pista's own outbound service credential(s) to UL Platform — one
# organization-scoped NA_PISTA API key per organization it acts for
# (OD-11 Alternative A, the decision this spike closes). Format: a map is
# not expressible in .env; the spike's test harness reads these straight
# out of the fixtures file the provisioning script writes, never from env,
# in this spike. A real deployment would use a secret store, not .env.

{
  "name": "na-pista-platform-integration-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "F19 spike — removable. Proves the Platform<->Na Pista integration contract in runtime; not the product's real architecture.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --outDir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/db-init.ts",
    "db:teardown": "tsx scripts/db-teardown.ts",
    "rls:spike": "tsx scripts/rls-spike.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node --import tsx --test --test-force-exit --test-timeout=30000 --test-concurrency=1 tests/e2e/*.test.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "eslint": "^10.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1"
  }
}
